default_platform(:ios)

PROJECT = "iosApp/Daftar.xcodeproj"
BUNDLE_ID = "com.aelshal.daftar"

platform :ios do
  desc "Sign the app with the secrets from GitHub Actions and upload it to TestFlight"
  lane :beta do
    # Temporary keychain that is deleted when the runner finishes.
    setup_ci

    tmp = ENV.fetch("RUNNER_TEMP", "/tmp")

    cert_path = File.join(tmp, "dist.p12")
    File.binwrite(cert_path, Base64.decode64(ENV.fetch("IOS_DIST_CERT_P12_BASE64")))
    import_certificate(
      certificate_path: cert_path,
      certificate_password: ENV.fetch("IOS_DIST_CERT_PASSWORD"),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )

    profile_path = File.join(tmp, "app.mobileprovision")
    File.binwrite(profile_path, Base64.decode64(ENV.fetch("IOS_PROFILE_APP_BASE64")))
    install_provisioning_profile(path: profile_path)
    profile_name = FastlaneCore::ProvisioningProfile.parse(profile_path)["Name"]

    team_id = ENV.fetch("APPLE_TEAM_ID")

    update_code_signing_settings(
      path: PROJECT,
      targets: ["Daftar"],
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: BUNDLE_ID
    )

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )

    build_app(
      project: PROJECT,
      scheme: "Daftar",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Daftar.ipa",
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER', '1')} DEVELOPMENT_TEAM=#{team_id}",
      export_options: {
        provisioningProfiles: { BUNDLE_ID => profile_name }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/Daftar.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
